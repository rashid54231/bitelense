# Supabase Project Credentials (Client-side / Public)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat Public SDK Keys (Client-side)
REVENUECAT_ANDROID_KEY=goog_your_android_key
REVENUECAT_IOS_KEY=appl_your_ios_key

# Legal URLs
PRIVACY_POLICY_URL=https://bitelens.app/privacy
TERMS_URL=https://bitelens.app/terms

# ========================================================
# Supabase Edge Functions Secrets (Server-side ONLY)
# Set via: supabase secrets set KEY=VALUE
# NEVER put these in the Flutter app!
# ========================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# FREE_DAILY_LIMIT=3
# REVENUECAT_WEBHOOK_SECRET=your_shared_webhook_secret
# MOCK_AI=false
